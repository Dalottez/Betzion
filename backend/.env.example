PORT=3022
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:4200,https://betzion.site,https://www.betzion.site
MONGODB_URI=
MONGODB_DB_NAME=betzion
# Leave MONGODB_URI blank and set LOCAL_DATA_DIR to a temporary folder when
# running isolated local payment tests with real gateway credentials.
LOCAL_DATA_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# ARCHPAY API v1 SETTINGS (M-PESA STK PUSH)
# Docs: https://pay.archietech.app  |  Base: https://pay.archietech.app/api/v1
# ─────────────────────────────────────────────────────────────────────────────
ARCHPAY_API_BASE=https://pay.archietech.app/api/v1

# ArchPay credentials (Dashboard -> API key, shown on account creation).
# Use the combined key, or leave it blank and set the public/secret pair.
ARCHPAY_API_KEY=
ARCHPAY_ACCOUNT_ID=

# Optional: route deposits through one specific Paybill / Till / Bank channel.
# Get the ID from GET /api/v1/channels. Blank uses the account default.
ARCHPAY_CHANNEL_ID=

# Webhook endpoint ArchPay calls when a payment completes or fails.
# ArchPay takes this from its dashboard, not from each request: paste the URL
# WITH the ?token=... query string into ArchPay -> Settings -> Webhook URL.
# The backend prints the exact URL to register on every start.
ARCHPAY_CALLBACK_URL=https://api.betzion.site/api/payments/archpay/callback
ARCHPAY_CALLBACK_TOKEN=

# Polling and timeout settings
ARCHPAY_PENDING_PAYMENT_EXPIRY_MS=300000
ARCHPAY_LATE_CONFIRMATION_WINDOW_MS=1800000

# Minimum Deposit Amount (KES)
MIN_DEPOSIT_AMOUNT=999
MAX_DEPOSIT_AMOUNT=1999

# Optional first-run administrator. Keep real values only in your secret store.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=Administrator
SEED_ADMIN_EMAIL=
